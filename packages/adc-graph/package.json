{
  "name": "@adc/graph",
  "version": "0.1.0",
  "description": "Principal-Graph event emitters: mint, attenuate, verify-allow, verify-deny, seal, revoke. See docs/PLAN.md Phase 6.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "npm run build -w @adc/core --if-present",
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "pretypecheck": "npm run build -w @adc/core --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@adc/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
