# Copy to .env and fill in. Never commit a real .env — MINT_ROOT_SECRET_KEY_B64
# is the single most sensitive value in this whole codebase. See README.md.

PORT=3001

# Base64, must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(Buffer.from(require('@adc/core').generateKeypair().secretKey).toString('base64'))"
MINT_ROOT_SECRET_KEY_B64=

# A local RBA instance — see that repo's own README/docker-compose.yml.
RBA_BASE_URL=http://localhost:3000
# READONLY_API_KEY is sufficient; this service never writes to RBA.
RBA_API_KEY=

# Optional; default 5000.
# RBA_TIMEOUT_MS=5000

# Bearer token required on POST /revoke. Any non-empty string; generate one
# with e.g. `openssl rand -hex 32`. Not the root key — narrower blast
# radius (revoke, not mint) — but still a secret: never commit a real one.
MINT_ADMIN_API_KEY=

# Optional; default 60 (1/sec sustained). Service-wide POST /mint rate limit
# — see src/rate-limiter.ts.
# MINT_RATE_LIMIT_PER_MINUTE=60

# Optional; unset means the revocation store is purely in-memory (lost on
# restart), exactly as it's always been. Set to a file path to persist
# revocations across restarts — see src/revocation-store.ts. The process
# must have read/write access to this path and its parent directory (which
# is created automatically if missing).
# MINT_REVOCATION_STORE_PATH=/var/lib/adc-mint/revoked.json

# Optional; unset means Principal-Graph events (docs/PLAN.md Phase 6) go to
# a private, process-local in-memory sink nobody outside this process can
# observe — exactly as it's always been. Set to a file path to append every
# 'mint'/'revoke' event as one NDJSON line — see @adc/graph's
# createNdjsonGraphSink and this service's own README. Use a real path
# (e.g. /var/log/adc-mint/events.ndjson) for a durable audit trail, or
# /dev/stdout on POSIX for a 12-factor-style "log to stdout" deployment.
# MINT_GRAPH_EVENTS_PATH=/var/log/adc-mint/events.ndjson
