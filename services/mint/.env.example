# Copy to .env and fill in. Never commit a real .env — MINT_ROOT_SECRET_KEY_B64
# is the single most sensitive value in this whole codebase. See README.md.

PORT=3001

# Base64, must decode to exactly 32 bytes. Generate one with:
#   node -e "console.log(Buffer.from(require('@adc/core').generateKeypair().secretKey).toString('base64'))"
MINT_ROOT_SECRET_KEY_B64=

# A local RBA instance — see that repo's own README/docker-compose.yml.
RBA_BASE_URL=http://localhost:3000
# READONLY_API_KEY is sufficient; this service never writes to RBA.
RBA_API_KEY=

# Optional; default 5000.
# RBA_TIMEOUT_MS=5000
